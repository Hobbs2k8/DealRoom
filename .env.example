# Copy to .env and fill in. .env is gitignored; never commit real values.

# Agent identity seeds (any long random string; keep them stable so addresses don't change)
BUYER_SEED=
SUPPLIER_SEED=

# Optional: Claude writes supplier messages and owner replies. Falls back to templates if unset.
ANTHROPIC_API_KEY=

# Optional: TypeSafe Jev model for supplier prediction. Falls back to HeuristicPredictor if unset.
TYPESAFE_API_KEY=
# Optional: Jev model name (SDK default is jev-latest)
TYPESAFE_MODEL=

# Demo company folder under data/
COMPANY_ID=company-001

# Optional: model for message writing (default claude-opus-5-5)
CLAUDE_MODEL=

# Owner cash floor used by the terminal demo (dollars)
CASH_FLOOR=20000

# Optional supplier settings for the demo (random if unset)
SUPPLIER_PERSONALITY=
SUPPLIER_SEASON=
SUPPLIER_RNG_SEED=

# Bureau port
BUREAU_PORT=8000

# Marketplace: owner deadline for delivery (days) and judge control file
NEED_BY_DAYS=7
MARKET_CONTROLS=market_controls.json

# Optional: ASI:One (Fetch.ai LLM). Reads owner messages, writes negotiation text, and is the LLM baseline in eval.
ASI_ONE_API_KEY=
